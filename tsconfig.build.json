{
  // 构建配置：在基础配置之上开启产出。
  // 注意 tsc 不会复制非 TS 资产（snapshot.js、web/public/*），
  // 那些由 scripts/copy-assets.mjs 负责。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "declaration": false
  },
  "include": ["src/**/*.ts"]
}
