{
  "name": "jevtest",
  "version": "0.1.0",
  "private": true,
  "description": "基于快速自主决策的 Web 测试套件平台：给测试地址和用例，自动跑完并产出报告",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "bin": {
    "jevtest": "./dist/cli.js"
  },
  "scripts": {
    "dev": "node --experimental-strip-types src/cli.ts",
    "serve": "node --experimental-strip-types src/cli.ts serve",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.ts\"",
    "doctor": "node --experimental-strip-types src/cli.ts doctor"
  },
  "dependencies": {
    "playwright": "^1.49.0",
    "yaml": "^2.6.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.0"
  }
}
