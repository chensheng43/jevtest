# 复制为 .env 后填写。.env 已在 .gitignore 中，凭证不会入库。

# ---------- 决策引擎（必填） ----------
# TypeSafe：一次请求同时决定「执行哪个操作」和「每个操作的候选目标」。
# 这是整个平台的决策来源，不填则任何用例都无法运行。
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# ---------- 文本取值小模型（可选） ----------
# 仅当决策结果是 TYPE_TEXT 时调用，用来把 goal 里的信息变成实际要输入的字符串。
# 不填则遇到需要输入文本的用例会直接报错，而不是猜一个值。
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://api.deepseek.com/v1
TEXT_MODEL=deepseek-chat

# ---------- 平台 ----------
# Web 平台监听端口，仅绑定 127.0.0.1。
JEVTEST_PORT=8770

# worker 并发度。1 = 串行（默认），越高越快也越贵：
# 单个用例约 10~20 次模型调用，并发会成倍放大费用。
JEVTEST_WORKERS=1

# 在途引擎请求数上限，默认 4。
# 与 JEVTEST_WORKERS 刻意解耦：前者限制浏览器内存，这个限制厂商侧限流。
# 两者瓶颈无关，绑成一个总闸会让其中一个白白闲置。
JEVTEST_ENGINE_INFLIGHT=4

# 无头模式，默认 true。要肉眼看 agent 操作过程时设 false。
JEVTEST_HEADLESS=true

# 是否录制 Playwright trace，默认 true。
# trace.zip 是排查失败时最有用的东西（时间轴 + 每步 DOM 快照），
# 而失败往往不可预测——关掉省下的磁盘通常不值一次「要是当时录了就好了」。
# 跑大批量、只关心通过与否时设为 off。
JEVTEST_TRACING=true

# 用例库目录与运行产物目录。
JEVTEST_CASES_DIR=./cases
JEVTEST_RUNS_DIR=./runs

# 登录态目录。每份登录态是 <名字>.json（Playwright 的 storageState 原样）+ <名字>.meta.json。
# 里面是真实会话 cookie：文件以 0600 写入，目录已在 .gitignore 里。
JEVTEST_AUTH_DIR=./auth

# 用例未声明 engine 时用哪个决策引擎。目前只有 typesafe 一个可选。
# 注意 `scripted` 是**测试专用**引擎，不在注册表里，也不能写进用例（见 docs/case-format.md）。
JEVTEST_DEFAULT_ENGINE=typesafe
